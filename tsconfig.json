{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		// Emit compiled test/shared JS inside extensions/dart/out so VS Code resolves
		// require("vscode") in tests to Dart-Code.dart-code's API instance.
		"outDir": "extensions/dart/out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": ".",
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"node"
		]
	},
	"exclude": [
		".crash_dumps",
		".dart_code_test_data_dir",
		".dcud",
		".dart_code_test_logs",
		".vscode-test",
		"node_modules",
		"out",
		"extensions/dart/out",
		"extensions/flutter/out",
		"src/test/test_projects",
		"eslint.config.js",
		"webpack.config.js"
		// tsconfig.build.json excludes additional paths
	]
}
